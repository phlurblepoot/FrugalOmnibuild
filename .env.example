# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATA_DIR: The directory where the app data is stored.
# Default is ./data
DATA_DIR="./data"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens.
# This should be a long, random string.
JWT_SECRET="your-super-secret-key-here"

# APP_PUBLIC_URL: this app's public HTTPS address. Mail sign-in (Google,
# Microsoft) builds its links from it (docs/mail-setup.md), and ONLYOFFICE and
# phone notifications fall back on it (below).
# APP_PUBLIC_URL=https://takeoff.example.com

# BACKUP_PATH: Where Settings → Backup writes its snapshots. Point this at a
# second volume/disk so a backup isn't on the same disk as the data it
# protects. Unset, backups still work but write under the data directory.
# BACKUP_PATH=/path/on/another/disk

# ── ONLYOFFICE document editor (docs/onlyoffice-setup.md) ────────────────────
# Editing documents needs ONLYOFFICE Docs running as a second container. Without
# these, everything else works and documents can be previewed, not edited.
# ONLYOFFICE_PUBLIC_URL: the HTTPS address browsers load the editor from —
# ONLYOFFICE's own subdomain. Unset, the document editor is "not configured".
# ONLYOFFICE_PUBLIC_URL=https://docs.example.com
# ONLYOFFICE_INTERNAL_URL: how this app reaches ONLYOFFICE server-to-server
# (connection checks, conversions). Defaults to ONLYOFFICE_PUBLIC_URL.
# ONLYOFFICE_INTERNAL_URL=http://onlyoffice
# APP_INTERNAL_URL: how ONLYOFFICE reaches this app server-to-server (to
# download files and send saves back). Defaults to APP_PUBLIC_URL.
# APP_INTERNAL_URL=http://app:3000
# ONLYOFFICE_JWT_SECRET: must equal JWT_SECRET on the ONLYOFFICE container.
# Long and random, e.g. the output of `openssl rand -hex 32`.
# ONLYOFFICE_JWT_SECRET=

# ── Phone push notifications ──────────────────────────────────────────────
# Nothing to set up: the server makes its own key pair on first use. Push
# services (Google, Apple, Mozilla) ask for a contact for whoever runs the
# server; this is it (a mailto: address or an https: URL). Defaults to
# APP_PUBLIC_URL. The server must be able to reach those services outbound.
# PUSH_CONTACT=mailto:office@example.com
