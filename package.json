{
  "name": "frugalomnibuild",
  "private": true,
  "version": "4.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx scripts/backup-data.ts",
    "restore": "tsx scripts/restore-data.ts",
    "migrate:manifest": "tsx scripts/migrate-manifest.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "test:e2e": "rm -rf .e2e-data && playwright test",
    "test:e2e:ui": "rm -rf .e2e-data && playwright test --ui",
    "demo:seed": "playwright test -c playwright.readme.config.ts --project=seed",
    "demo:serve": "node e2e/readme/serve.mjs",
    "screenshots": "playwright test -c playwright.readme.config.ts"
  },
  "dependencies": {
