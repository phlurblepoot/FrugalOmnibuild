    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "konva": "^10.2.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.17",
    "motion": "^12.23.24",
